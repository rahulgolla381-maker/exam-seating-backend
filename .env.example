# ==============================================================================
# Exam Hall Seating Allocator - Backend Environment Configuration (.env.example)
# ==============================================================================
# Copy this template when setting up local or cloud deployment environments.
# Never commit real production passwords, database secrets, or private keys!

# Server Port
PORT=8083

# Local Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=exam_seating_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_USE_SSL=false
DB_ALLOW_PUBLIC_KEY=true

# Cloud Database Configuration (e.g. Aiven MySQL)
# Cloud providers like Aiven provide a complete JDBC connection string:
# SPRING_DATASOURCE_URL=jdbc:mysql://<aiven-service-uri>:<port>/defaultdb?sslMode=REQUIRED
# SPRING_DATASOURCE_USERNAME=avnadmin
# SPRING_DATASOURCE_PASSWORD=<aiven-password>

# JWT Authentication
# Must be a secure key of at least 256 bits (32 bytes)
JWT_SECRET=your_secure_random_256_bit_secret_key_minimum_32_characters
JWT_EXPIRATION=86400000

# CORS Allowed Origins
# Comma-separated list of allowed frontend origins (e.g. your Vercel frontend domain)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-app.vercel.app
